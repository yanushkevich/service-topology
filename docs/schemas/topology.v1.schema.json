{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/schemas/topology.v1.schema.json",
  "title": "TopologyData v1",
  "description": "Canonical topology payload: environments, logical service definitions, per-environment service instances, infrastructure resources (incl. Kafka topics and RabbitMQ queues/exchanges), communication relationships, and optional event types. Mirrors src/domain/types.ts; referential integrity (IDs, parents, cycles, environments) is enforced by validateTopology (src/domain/validation.ts), which JSON Schema cannot express. Contract tests keep enums in sync with the code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["environments", "serviceDefinitions", "serviceInstances", "resources", "relationships"],
  "properties": {
    "environments": { "type": "array", "items": { "$ref": "#/$defs/EnvironmentRecord" } },
    "serviceDefinitions": { "type": "array", "items": { "$ref": "#/$defs/ServiceDefinition" } },
    "serviceInstances": { "type": "array", "items": { "$ref": "#/$defs/ServiceInstance" } },
    "resources": { "type": "array", "items": { "$ref": "#/$defs/InfrastructureResource" } },
    "relationships": { "type": "array", "items": { "$ref": "#/$defs/CommunicationRelationship" } },
    "eventTypes": {
      "type": "array",
      "items": { "$ref": "#/$defs/EventType" },
      "description": "Optional (added within v1, ADR-014). Logical event contracts carried on topics, queues, or exchanges."
    },
    "businessFlows": {
      "type": "array",
      "items": { "$ref": "#/$defs/BusinessFlow" },
      "description": "Optional (added within v1, ADR-022). Business processes across services; every transition between two services is backed by a relationship or an event type (validateTopology)."
    }
  },
  "$defs": {
    "EntityId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable, opaque ID, unique across all collections of one topology."
    },
    "Timestamp": { "type": "string", "format": "date-time" },
    "Provider": { "enum": ["aws", "azure", "gcp", "on-prem", "saas", "internal", "unknown"] },
    "HealthStatus": { "enum": ["healthy", "degraded", "unavailable", "unknown"] },
    "EnvironmentKind": { "enum": ["development", "staging", "production", "other"] },
    "ServiceCategory": { "enum": ["api", "gateway", "application", "worker", "scheduled-job", "other"] },
    "ResourceType": {
      "enum": [
        "account", "subscription", "project", "region", "datacenter", "cluster", "namespace", "workload",
        "database", "cache", "search-index", "broker", "topic", "queue", "exchange", "external-resource", "other"
      ]
    },
    "Protocol": {
      "enum": ["http", "https", "graphql", "grpc", "websocket", "kafka", "rabbitmq", "tcp", "tls", "postgresql", "mysql", "mongodb", "redis", "other"]
    },
    "CommunicationPattern": { "enum": ["synchronous", "asynchronous", "streaming", "scheduled", "database", "unknown"] },
    "RelationshipStatus": { "enum": ["active", "degraded", "inactive", "unknown"] },
    "Metadata": { "type": "object", "description": "Free-form, display-only attributes. Never used for identity or hierarchy." },
    "Metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isSimulated"],
      "properties": {
        "latencyMs": { "type": "number", "minimum": 0 },
        "throughputPerSecond": { "type": "number", "minimum": 0 },
        "errorRatePercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "isSimulated": {
          "type": "boolean",
          "description": "True for generated/mock values. Clients must label simulated telemetry and never present it as observed."
        },
        "observedAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "EnvironmentRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/EntityId" },
        "name": { "type": "string" },
        "kind": { "$ref": "#/$defs/EnvironmentKind" }
      }
    },
    "ServiceDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "protocols"],
      "properties": {
        "id": { "$ref": "#/$defs/EntityId" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "owner": { "type": "string" },
        "team": { "type": "string" },
        "category": { "$ref": "#/$defs/ServiceCategory" },
        "protocols": { "type": "array", "items": { "$ref": "#/$defs/Protocol" } },
        "metadata": { "$ref": "#/$defs/Metadata" }
      }
    },
    "ServiceInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "serviceDefinitionId", "environmentId", "provider", "health", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/EntityId" },
        "serviceDefinitionId": { "$ref": "#/$defs/EntityId" },
        "environmentId": { "$ref": "#/$defs/EntityId", "description": "Exactly one environment per instance." },
        "provider": { "$ref": "#/$defs/Provider" },
        "health": { "$ref": "#/$defs/HealthStatus" },
        "version": { "type": "string" },
        "endpoint": { "type": "string" },
        "resourceId": { "$ref": "#/$defs/EntityId", "description": "Most specific known host (namespace, cluster, …)." },
        "metrics": { "$ref": "#/$defs/Metrics" },
        "updatedAt": { "$ref": "#/$defs/Timestamp" },
        "metadata": { "$ref": "#/$defs/Metadata" }
      }
    },
    "InfrastructureResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "provider"],
      "properties": {
        "id": { "$ref": "#/$defs/EntityId" },
        "name": { "type": "string" },
        "type": { "$ref": "#/$defs/ResourceType" },
        "provider": { "$ref": "#/$defs/Provider" },
        "parentResourceId": { "$ref": "#/$defs/EntityId", "description": "Explicit containment; no cycles. Inherited by children for environment." },
        "environmentId": { "$ref": "#/$defs/EntityId" },
        "health": { "$ref": "#/$defs/HealthStatus" },
        "owner": { "type": "string" },
        "team": { "type": "string" },
        "metrics": { "$ref": "#/$defs/Metrics" },
        "updatedAt": { "$ref": "#/$defs/Timestamp" },
        "metadata": { "$ref": "#/$defs/Metadata" }
      }
    },
    "FlowPolicy": {
      "type": "object",
      "additionalProperties": false,
      "description": "A protection on a business-flow transition (ADR-022): call, asynchronous, or process level.",
      "required": ["type", "label"],
      "properties": {
        "type": {
          "enum": ["timeout", "retry", "breaker", "bulkhead", "idempotency", "redelivery", "dead-letter", "idempotent-consumer", "outbox", "step-deadline", "compensation", "manual-intervention"]
        },
        "label": { "type": "string" },
        "config": { "type": "object", "additionalProperties": { "type": "string" } },
        "state": { "enum": ["exercised", "idle", "missing", "unknown"] },
        "stat": { "type": "string" }
      }
    },
    "FlowStep": {
      "type": "object",
      "additionalProperties": false,
      "description": "A step of a business flow, owned by one service. Step IDs are unique within their flow.",
      "required": ["id", "name", "serviceDefinitionId", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "serviceDefinitionId": { "$ref": "#/$defs/EntityId" },
        "kind": { "enum": ["task", "decision", "wait", "compensation", "manual"] },
        "entryPoint": { "type": "string", "description": "Operation implementing the step; links to the service's transit board line." },
        "deadlineMs": { "type": "number", "minimum": 0 },
        "compensatedBy": { "type": "string", "minLength": 1, "description": "ID of the compensation step that undoes this one." }
      }
    },
    "FlowTransition": {
      "type": "object",
      "additionalProperties": false,
      "description": "How control passes between steps: local (same service), call (a relationship from the caller), or event (the event type's producer → consumer flow). To an outcome ID, it ends the flow.",
      "required": ["id", "from", "to", "via", "policies"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "via": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "local" } } },
            { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "call" }, "callerServiceId": { "$ref": "#/$defs/EntityId" } } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "eventTypeId"], "properties": { "kind": { "const": "event" }, "eventTypeId": { "$ref": "#/$defs/EntityId" } } }
          ]
        },
        "condition": { "type": "string", "description": "Taken only when this holds; unconditional transitions always run." },
        "policies": { "type": "array", "items": { "$ref": "#/$defs/FlowPolicy" } }
      }
    },
    "BusinessFlow": {
      "type": "object",
      "additionalProperties": false,
      "description": "A business process across services (ADR-022). Environment-independent, like an event type; consistency with relationships and event types is enforced by validateTopology.",
      "required": ["id", "name", "trigger", "startStepId", "steps", "transitions", "outcomes", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/EntityId" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "owner": { "type": "string" },
        "team": { "type": "string" },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "enum": ["call", "event", "schedule", "manual"] }, "ref": { "$ref": "#/$defs/EntityId" } }
        },
        "startStepId": { "type": "string", "minLength": 1 },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "p95Ms": { "type": "number", "minimum": 0 }, "completionMs": { "type": "number", "minimum": 0 } }
        },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/FlowStep" } },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/FlowTransition" } },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "kind"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string" },
              "kind": { "enum": ["success", "cancelled", "failed", "compensated"] }
            }
          }
        },
        "source": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "authored" } } },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "format", "ref", "importedAt"],
              "properties": { "kind": { "const": "imported" }, "format": { "type": "string" }, "ref": { "type": "string" }, "importedAt": { "$ref": "#/$defs/Timestamp" } }
            }
          ]
        },
        "metadata": { "$ref": "#/$defs/Metadata" }
      }
    },
    "EventType": {
      "type": "object",
      "additionalProperties": false,
      "description": "A logical message contract (e.g. OrderPlaced). Environment-independent; resolves per environment to its channel there and the producer/consumer instances' existing relationships. Consistency with relationships is enforced by validateTopology.",
      "required": ["id", "name", "channelResourceIds", "producerServiceIds", "consumerServiceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/EntityId" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "schemaVersion": { "type": "string" },
        "owner": { "type": "string" },
        "team": { "type": "string" },
        "channelResourceIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/EntityId" },
          "description": "Topic, queue, or exchange resources; at most one per environment."
        },
        "producerServiceIds": { "type": "array", "items": { "$ref": "#/$defs/EntityId" }, "description": "ServiceDefinition IDs." },
        "consumerServiceIds": { "type": "array", "items": { "$ref": "#/$defs/EntityId" }, "description": "ServiceDefinition IDs." },
        "metadata": { "$ref": "#/$defs/Metadata" }
      }
    },
    "CommunicationRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceEntityId", "targetEntityId", "protocol", "pattern", "direction", "status", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/EntityId" },
        "sourceEntityId": { "$ref": "#/$defs/EntityId" },
        "targetEntityId": { "$ref": "#/$defs/EntityId" },
        "protocol": { "$ref": "#/$defs/Protocol" },
        "pattern": { "$ref": "#/$defs/CommunicationPattern" },
        "direction": { "enum": ["unidirectional", "bidirectional"] },
        "status": { "$ref": "#/$defs/RelationshipStatus" },
        "authenticationType": { "type": "string" },
        "endpoint": { "type": "string" },
        "metrics": { "$ref": "#/$defs/Metrics" },
        "metadata": { "$ref": "#/$defs/Metadata" },
        "updatedAt": { "$ref": "#/$defs/Timestamp" }
      }
    }
  }
}
