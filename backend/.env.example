# MongoDB local development (make dev-up). Create secrets/mongodb_root_password.txt first, e.g.
#   (umask 077; openssl rand -base64 24 | tr -d '/+=\n' > secrets/mongodb_root_password.txt)
# The URI never carries credentials; replicaSet=rs0 matches docker-compose.yml (transactions need it).
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=topology
MONGODB_USERNAME=root
# Password is supplied via a local file (also the Docker secret); do not commit it.
MONGODB_PASSWORD_FILE=./secrets/mongodb_root_password.txt
MONGODB_AUTH_SOURCE=admin
MONGODB_TIMEOUT=10s
HTTP_ADDR=127.0.0.1:8080
SEED_MODE=demo
