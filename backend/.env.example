# ArcadeDB local development. Create secrets/arcadedb_root_password.txt with a password of 8+ characters.
ARCADEDB_BASE_URL=http://127.0.0.1:2480
ARCADEDB_DATABASE=topology
ARCADEDB_USERNAME=root
# Password is supplied via local Docker secret; do not commit the secret file.
ARCADEDB_PASSWORD_FILE=./secrets/arcadedb_root_password.txt
ARCADEDB_QUERY_LANGUAGE=sql
ARCADEDB_REQUEST_TIMEOUT=10s
HTTP_ADDR=:8080
SEED_MODE=demo
